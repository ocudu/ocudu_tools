# Copy to .env and edit. review-box.sh fills in HOST_UID/HOST_GID itself.

OS_VERSION=26.04

# --- repos ---------------------------------------------------------------
# SRC_<REPO>: absolute host path, bind-mounted read-only. Comment it out and the repo is
# cloned from CLONE_<REPO> (optionally at REF_<REPO>) into the container on every start,
# and discarded when it exits.

# The checkout under review. Mount the main checkout, not a linked worktree: the review
# workspace borrows its objects from <checkout>/.git.
SRC_OCUDU=/home/you/repos/ocudu

# Code guide: docs/dev_guide/code_guide.
SRC_OCUDU_DOCS=/home/you/repos/ocudu_docs

# 3GPP specs in markdown. Large; mount it if you have a clone, otherwise it is cloned
# shallow on each start.
#SRC_3GPP_MD=/home/you/repos/3gpp_md

# Shared skills (ocudu-code-review): the ocudu_tools checkout this box lives in.
SRC_OCUDU_TOOLS=/home/you/repos/ocudu_tools

# Clone URLs and refs, used only when the matching SRC_ is unset. Defaults are in
# docker-compose.yml.
#CLONE_OCUDU=git@gitlab.com:ocudu/ocudu.git
#REF_OCUDU=dev

# --- review --------------------------------------------------------------
# Base a diff review compares against.
#REVIEW_BASE=origin/dev

# --- build cache ---------------------------------------------------------
# ccache is shared with the host (~/.cache/ccache); keep this equal to your host max_size.
#CCACHE_MAXSIZE=10G

# --- credentials -----------------------------------------------------------
# Claude credentials are copied from ~/.claude on start. Set these only if you need them.
#ANTHROPIC_API_KEY=
# glab's token, to read MRs. Give it only the read_api scope: the box must not be able to write to GitLab.
#GITLAB_TOKEN=
