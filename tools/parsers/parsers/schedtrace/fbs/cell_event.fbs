include "cell_start_event.fbs";
include "cell_slot_event.fbs";
include "cell_stop_event.fbs";

namespace ocudu.schedtrace.fbs;

// The file format version is split in two single-value enums, as FlatBuffers has no constants and an enum rejects
// duplicate values.

/// Major version of the schedtrace file format. Readers reject files with a different major version.
///
/// Bump on schema changes that older readers cannot decode, such as removing, retyping or reordering fields, and
/// reset FileFormatVersionMinor to 0.
enum FileFormatVersionMajor : uint16 {
  Value = 2,
}

/// Minor version of the schedtrace file format.
///
/// Bump on backward compatible changes, such as appending fields to a table or adding tables.
enum FileFormatVersionMinor : uint16 {
  Value = 1,
}

union CellEventValue {
  CellStartEvent,
  CellSlotEvent,
  CellStopEvent,
}

/// Container for all cell related events.
table CellEvent {
  /// Timestamp of the event, in microseconds since the Unix epoch.
  timestamp_us: int64;
  value: CellEventValue;
}

root_type CellEvent;
